# Copy to .env.local for local development.
# Obtain these values from your own Supabase project settings.
# Never commit real credentials or service-role keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Keep these out of NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
AGE_VERIFICATION_PROVIDER=
AGE_VERIFICATION_API_KEY=
